local tabButtons = {}
local tabContents = {}

local function selectTab(name, contentFrame, btn)
    for tabName, b in pairs(tabButtons) do
        b.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
    for tabName, cf in pairs(tabContents) do
        cf.Visible = (tabName == name)
    end
    btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
end

local function addToggle(parent, flagName, labelText, yOffset)
    local row = Instance.new("Frame", parent)
    row.Name = "Toggle_" .. flagName
    row.Size = UDim2.new(1, -20, 0, 34)
    row.Position = UDim2.fromOffset(10, yOffset)
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.Parent = parent

    local label = Instance.new("TextLabel", row)
    label.Name = "Label"
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.fromOffset(0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 16
    label.Parent = row

    local btn = Instance.new("TextButton", row)
    btn.Name = "ToggleButton"
    btn.Size = UDim2.fromOffset(50, 24)
    btn.Position = UDim2.fromOffset(0, 5)
    btn.Text = "OFF"
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = row

    btn.MouseButton1Click:Connect(function()
        local newVal = not rawget(_G, flagName)
        rawset(_G, flagName, newVal)
        btn.Text = newVal and "ON" or "OFF"
        btn.BackgroundColor3 = newVal and Color3.fromRGB(60, 170, 90) or Color3.fromRGB(60, 60, 60)
    end)

    return btn
end

local function createTab(tabData)
    local btn = Instance.new("TextButton", tabContainer)
    btn.Name = "Tab_" .. tabData.name
    btn.Size = UDim2.fromOffset(90, 30)
    btn.Position = UDim2.fromOffset((#tabButtons - 1) * 95, 0)
    btn.Text = tabData.name
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.Parent = tabContainer
    tabButtons[tabData.name] = btn

    local content = Instance.new("Frame", tabContainer)
    content.Name = "Content_" .. tabData.name
    content.Size = UDim2.fromOffset(0, 0)
    content.Position = UDim2.fromOffset(0, 40)
    content.BackgroundTransparency = 1
    content.Visible = (tabData.name == "FARM")
    content.Parent = tabContainer
    tabContents[tabData.name] = content

    local yOffset = 0
    for _, t in ipairs(tabData.toggles) do
        addToggle(content, t[1], t[2], yOffset)
        yOffset = yOffset + 38
    end

    btn.MouseButton1Click:Connect(function()
        selectTab(tabData.name, content, btn)
    end)

    return content
end

for _, tabData in ipairs(tabsData) do
    createTab(tabData)
end

selectTab("FARM", tabContents["FARM"], tabButtons["FARM"])

