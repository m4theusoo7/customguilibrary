local function createContentFrame(tabName, toggleCount)
    local content = Instance.new("Frame", mainFrame)
    content.Name = "Content_" .. tabName
    content.Position = UDim2.fromOffset(8, 78)
    content.Size = UDim2.new(1, -16, 0, 38 * toggleCount + 12)
    content.BackgroundTransparency = 1
    content.Visible = (tabName == "FARM")
    content.Parent = mainFrame
    return content
end

local tabButtons = {}
local tabContents = {}

local function selectTab(name, contentFrame, btn)
    for tabName, b in pairs(tabButtons) do
        b.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
        b.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
    for tabName, cf in pairs(tabContents) do
        cf.Visible = (tabName == name)
    end
    btn.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
end

local function addToggle(parent, flagName, labelText, yOffset, toggleHeight)
    toggleHeight = toggleHeight or 34
    local row = Instance.new("Frame", parent)
    row.Name = "Toggle_" .. flagName
    row.Size = UDim2.new(1, -20, 0, toggleHeight)
    row.Position = UDim2.fromOffset(0, yOffset)
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.Parent = parent

    local label = Instance.new("TextLabel", row)
    label.Name = "Label"
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.fromOffset(0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(220, 220, 225)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 15
    label.Parent = row

    local btn = Instance.new("TextButton", row)
    btn.Name = "ToggleButton"
    btn.Size = UDim2.fromOffset(48, 24)
    btn.Position = UDim2.fromOffset(0, 5)
    btn.Text = "OFF"
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = row

    btn.MouseButton1Click:Connect(function()
        local current = rawget(_G, flagName) or false
        local newVal = not current
        rawset(_G, flagName, newVal)
        btn.Text = newVal and "ON" or "OFF"
        btn.BackgroundColor3 = newVal and Color3.fromRGB(50, 150, 80) or Color3.fromRGB(60, 60, 60)
    end)

    return btn
end

local function createTab(tabData)
    local btn = Instance.new("TextButton", tabContainer)
    btn.Name = "Tab_" .. tabData.name
    btn.Size = UDim2.fromOffset(80, 30)
    btn.Position = UDim2.fromOffset((#tabButtons - 1) * 92, 3)
    btn.Text = tabData.name
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = tabContainer
    tabButtons[tabData.name] = btn

    local content = createContentFrame(tabData.name, #tabData.toggles)
    content.Visible = (tabData.name == "FARM")
    tabContents[tabData.name] = content

    local yOffset = 8
    for _, t in ipairs(tabData.toggles) do
        addToggle(content, t[1], t[2], yOffset)
        yOffset = yOffset + 38
    end

    btn.MouseButton1Click:Connect(function()
        selectTab(tabData.name, content, btn)
    end)

    return content
end

